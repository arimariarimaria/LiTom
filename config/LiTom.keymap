#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Overrides must follow the runtime processor definitions above.
&mouse_runtime_input_processor {
    // New storage keys prevent legacy settings from overriding these defaults.
    processor-label = "LiTom Mouse";
    temp-layer-enabled;
    temp-layer = <2>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <400>;
};

&scroll_runtime_input_processor {
    processor-label = "LiTom Scroll";
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    active-layers = <(1 << 3)>;
    xy-to-scroll-enabled;
    y-invert;
    // Keep the existing effective gain: runtime 1/60, then wheel-only 1/16.
};

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tab_slide_windows: behavior_sensor_rotate_tab_slide_windows {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_WINDOWS_TABS";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LC(PAGE_DOWN)>;
            ccw-binding = <&kp LC(PAGE_UP)>;
            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
            ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
            tap-ms = <20>;
        };
    };

    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        grave {
            slot = <0>;
            bindings = <&kp GRAVE>;
            key-positions = <6 5>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        efu7 {
            slot = <1>;
            bindings = <&kp F7>;
            key-positions = <6 7>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        efu9 {
            slot = <2>;
            bindings = <&kp F9>;
            key-positions = <8 9>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        efu10 {
            slot = <3>;
            bindings = <&kp F10>;
            key-positions = <9 10>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        efu12 {
            slot = <4>;
            bindings = <&kp F12>;
            key-positions = <10 11>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        efu2 {
            slot = <5>;
            bindings = <&kp F2>;
            key-positions = <4 5>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        pscrn {
            slot = <6>;
            bindings = <&kp PRINTSCREEN>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            display-name = "Mac";
            bindings = <
&kp ESCAPE  &kp DELETE
&kp TAB     &kp Q         &kp W             &kp E  &kp R  &kp T      &kp Y      &kp U            &kp I           &kp O            &kp P             &kp UNDERSCORE
&mo 4       &kp A         &kp S             &kp D  &kp F  &kp G      &kp H      &kp J            &kp K           &kp L            &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LSHFT   &kp Z         &kp X             &kp C  &kp V  &kp B      &kp N      &kp M            &kp COMMA       &kp PERIOD       &kp DOWN          &kp UP
&kp LCTRL   &kp LEFT_ALT  &kp LEFT_COMMAND  &mo 3  &mo 2  &kp SPACE  &kp ENTER  &lt 4 BACKSPACE  &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        windows_layer {
            display-name = "Windows";
            bindings = <
&kp ESCAPE  &kp DELETE
&kp TAB     &kp Q         &kp W             &kp E  &kp R  &kp T      &kp Y      &kp U            &kp I           &kp O            &kp P             &kp UNDERSCORE
&mo 4       &kp A         &kp S             &kp D  &kp F  &kp G      &kp H      &kp J            &kp K           &kp L            &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LSHFT   &kp Z         &kp X             &kp C  &kp V  &kp B      &kp N      &kp M            &kp COMMA       &kp PERIOD       &kp DOWN          &kp UP
&kp LGUI   &kp LEFT_ALT  &kp LCTRL  &mo 3  &mo 2  &kp SPACE  &kp ENTER  &lt 4 BACKSPACE  &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <
                &tab_slide_windows
                &scroll_up_down
                &scroll_up_down
            >;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans
&trans  &kp N7        &kp N8        &kt N9        &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans  &mo 4   &trans    &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans      &trans
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        ARROW {
            display-name = "Arrow";
            bindings = <
&trans     &trans
&kp GRAVE  &kp LC(LS(TAB))         &kp LG(RIGHT)  &kp NUMBER_9             &kp NUMBER_0       &oled_mode  &oled_mode  &trans  &kp RC(LEFT_ARROW)  &kp UP_ARROW      &kp RC(RIGHT_ARROW)  &kp LG(P)
&kp TAB    &kp LA(LG(LEFT_ARROW))  &kp LG(LEFT)   &kp LG(LA(RIGHT_ARROW))  &kp LEFT_BRACKET   &trans      &trans      &trans  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp LG(K)
&kp LCMD   &kp LG(LS(LEFT_ARROW))  &trans         &kp LG(LS(RIGHT_ARROW))  &kp RIGHT_BRACKET  &trans      &trans      &trans  &trans              &kp LC(UP_ARROW)  &trans               &kp LG(L)
&trans     &trans                  &trans         &trans                   &trans             &trans      &trans      &trans  &trans              &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        NUM {
            display-name = "Num";
            bindings = <
&trans                   &trans
&kp GRAVE                &kp NUMBER_7  &kp NUMBER_8  &kp LG(LS(NUMBER_4))  &kp PLUS      &trans  &trans  &kp BACKSLASH    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SEMICOLON
&kp SLASH                &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6          &kp ASTERISK  &trans  &trans  &kp EXCLAMATION  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SQT
&mt LEFT_SHIFT NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3          &kp PERIOD    &trans  &trans  &kp NUMBER_0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans                   &trans        &trans        &trans                &trans        &trans  &trans  &kp LEFT_SHIFT   &trans        &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        FUNCTION {
            display-name = "Function";
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F1  &kp F2  &kp F3   &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans  &kp F13  &kp F6  &kp F7  &kp F8   &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans   &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &kp F12
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        BT {
            display-name = "Bt";
            bindings = <
&trans          &trans
&kp LG(Q)       &kp LC(W)  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans  &trans  &bt BT_PRV  &bt BT_NXT  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LG(LS(Z))   &trans     &kp LC(C)     &trans        &trans        &trans  &trans  &trans      &trans      &trans        &trans        &trans
&kp LG(Z)       &kp LG(X)  &kp LG(C)     &kp LG(V)     &trans        &trans  &trans  &trans      &trans      &trans        &trans        &trans
&studio_unlock  &trans     &trans        &trans        &trans        &trans  &trans  &trans      &trans      &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };
    };
};
